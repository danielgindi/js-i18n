{
  "name": "js-i18n",
  "version": "1.3.3",
  "description": "An i18n library, with support for plurals, dates, C style format specifiers and more.",
  "main": "dist/i18n.cjs.min.js",
  "module": "dist/i18n.es6.min.js",
  "broswer": "dist/i18n.umd.min.js",
  "types": "dist/i18n.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.es6.min.js",
      "require": "./dist/i18n.cjs.min.js",
      "default": "./dist/i18n.es6.min.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielgindi/js-i18n"
  },
  "engines": {
    "node": ">=8"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization"
  ],
  "scripts": {
    "build": "npm run lint && node ./scripts/build.js",
    "lint": "eslint -f codeframe ./",
    "lint-fix": "eslint -f codeframe --fix ./",
    "test": "mocha tests",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "author": "Daniel Cohen Gindi <danielgindi@gmail.com> (https://github.com/danielgindi)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danielgindi/js-i18n/issues"
  },
  "homepage": "https://github.com/danielgindi/js-i18n",
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "chai": "^6.3.0",
    "core-js": "^3.51.0",
    "eslint": "^10.15.0",
    "eslint-formatter-codeframe": "^7.32.2",
    "esm": "^3.2.25",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "pinst": "^3.0.0",
    "rollup": "^4.68.6",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3"
  }
}
